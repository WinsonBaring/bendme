{
  "name": "bendme-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "oxlint src",
    "test": "node --test scripts/*.test.mjs",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.76.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "type": "module"
}
